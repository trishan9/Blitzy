<group name="ecommerce,">

  <rule id="100011" level="3">
    <decoded_as>json</decoded_as>
    <field name="sec_event">AUTH_LOGIN_FAILURE</field>
    <description>Failed sign-in attempt</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100010" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100011</if_matched_sid>
    <description>Brute force: repeated login failures (T1110)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

<rule id="100021" level="3">
    <decoded_as>json</decoded_as>
    <field name="status_code">^404$</field>
    <description>Request answered 404</description>
  </rule>

  <rule id="100020" level="10" frequency="15" timeframe="30">
    <if_matched_sid>100021</if_matched_sid>
    <same_source_ip />
    <description>Possible IDOR/enumeration: 404 burst from one source (T1190)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

<rule id="100030" level="10">
    <decoded_as>json</decoded_as>
    <field name="sec_event">AUTHZ_DENIED</field>
    <description>Authorization denied (possible privilege escalation) (T1068)</description>
    <mitre><id>T1068</id></mitre>
  </rule>

  <rule id="100040" level="10">
    <decoded_as>json</decoded_as>
    <field name="sec_event">SESSION_REVOKED</field>
    <description>Session revoked — possible stolen token (T1539)</description>
    <mitre><id>T1539</id></mitre>
  </rule>

  <rule id="100050" level="10">
    <decoded_as>json</decoded_as>
    <field name="sec_event">JWT_VERIFY_FAILURE</field>
    <description>JWT verification failure (alg/kid tampering) (T1550)</description>
    <mitre><id>T1550</id></mitre>
  </rule>

  <rule id="100060" level="7">
    <decoded_as>json</decoded_as>
    <field name="sec_event">SSRF_BLOCKED</field>
    <description>SSRF attempt blocked by the app guard (T1190)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100070" level="10">
    <decoded_as>json</decoded_as>
    <field name="sec_event">PROMPT_INJECTION_DETECTED</field>
    <description>Prompt injection detected in AI input or retrieved chunk</description>
  </rule>

  <rule id="100080" level="12">
    <decoded_as>json</decoded_as>
    <field name="sec_event">CANARY_LEAKED</field>
    <description>AI system-prompt CANARY LEAKED — prompt disclosure (T1020)</description>
    <mitre><id>T1020</id></mitre>
  </rule>

  <rule id="100090" level="7">
    <decoded_as>json</decoded_as>
    <field name="sec_event">UPLOAD_REJECTED</field>
    <description>File upload rejected (magic-byte / type) (T1105)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>
