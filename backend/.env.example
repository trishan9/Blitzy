# ============================================================================
#  backend/.env.example — copy to backend/.env and fill in.
#  NO real secret ever goes in this file (it is tracked in git). In production,
#  every SECRET/KEY below is injected via Docker secrets, not a committed file.
# ============================================================================

NODE_ENV=development
PORT=8000

# --- Public base URL (brief §7.14) ------------------------------------------
# ALL absolute URLs (reset links, order emails, payment returns, webhook
# callbacks) are built from APP_URL — NEVER from req.headers.host or
# X-Forwarded-Host.
APP_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# Exact number of trusted proxy hops in front of the API (nginx -> api = 1).
# NEVER "true": that lets a client spoof X-Forwarded-For and defeat rate limits.
TRUST_PROXY_HOPS=1

# --- PostgreSQL (brief §2, §3) ----------------------------------------------
# app_rw: the application connection. RLS applies to it; it cannot DDL.
DATABASE_URL=postgres://app_rw:CHANGE_ME@postgres:5432/ecommerce
# migrator: owns the schema, runs drizzle-kit migrations. App never uses this.
MIGRATOR_DATABASE_URL=postgres://migrator:CHANGE_ME@postgres:5432/ecommerce
# Superuser passwords consumed once by db-setup.sql at init (via secrets in prod).
APP_RW_PW=CHANGE_ME
APP_RO_PW=CHANGE_ME
MIGRATOR_PW=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (rate limiting, Better Auth secondary storage, BullMQ) -----------
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# --- MongoDB (retained ONLY for the append-only activity_log, brief §2) -----
MONGO_URI=mongodb://mongo:27017/activity_log

# --- Better Auth (brief §4) -------------------------------------------------
# 32+ byte random secret. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:8000
# Comma-separated exact origins allowed to call auth routes (CSRF defence).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# OAuth providers (Authorization Code + PKCE handled by the library).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- JWT plugin (brief §5) --------------------------------------------------
# EdDSA keys are managed by Better Auth (JWKS endpoint). These are the claim
# checks your own middleware enforces.
JWT_ISS=http://localhost:8000
JWT_AUD=ecommerce-api

# --- Crypto wrapper (brief §7.21) -------------------------------------------
# Master key for the AES-256-GCM / HKDF key hierarchy. 32 bytes base64.
# openssl rand -base64 32
CRYPTO_MASTER_KEY=CHANGE_ME
# Pepper mixed into the email blind index HMAC. Separate from the master key.
BLIND_INDEX_PEPPER=CHANGE_ME

# --- Stripe (brief §7.18) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Image storage ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI assistant (brief §6.2, §8) ------------------------------------------
OPENAI_API_KEY=
# Pinned model id from config — NEVER a model name supplied by the client.
AI_MODEL_ID=gpt-4o-mini
# Per-request / per-user-day / global token caps.
AI_MAX_TOKENS_PER_REQUEST=2000
AI_MAX_TOKENS_PER_USER_DAY=50000

# --- SSRF allowlist (brief §7.6) --------------------------------------------
# Comma-separated exact external hostnames permitted for image-import / webhooks.
SSRF_ALLOWED_HOSTS=

# ============================================================================
#  DEMO / PENTEST FLAGS (brief §9) — ALL DEFAULT SECURE (unset == false).
#  The app REFUSES TO START with any of these set unless NODE_ENV != production
#  AND DEMO_MODE=true. Enable exactly ONE at a time. `npm run demo:list` prints
#  each flag, its vuln class, CWE, and affected endpoint.
# ============================================================================
DEMO_MODE=false
# Leave every flag below UNSET for the secure application. Examples only:
# DISABLE_SQL_ALLOWLIST=
# DISABLE_OUTPUT_SANITISE=
# DISABLE_CSRF=
# REFLECT_CORS_ORIGIN=
# DISABLE_SSRF_GUARD=
# SHELL_OUT_FOR_PDF=
# TRUST_UPLOAD_FILENAME=
# SKIP_OWNERSHIP_PREDICATE=
# SKIP_ROLE_CHECK=
# DISABLE_LOCKOUT=
# TRUST_CLIENT_TOTAL=
# HOST_HEADER_LINKS=
# NON_ATOMIC_STOCK=
# TRUST_UPLOAD_MIMETYPE=
# ALLOW_UNKNOWN_KEYS=
# VERBOSE_ERRORS=
# RAW_LLM_CONTEXT=
# RENDER_LLM_MARKDOWN=
# UNSAFE_DESERIALIZE=
# MONGO_RAW_FILTER=
# USE_NAIVE_JWT_VERIFIER=
# JWT_ACCEPT_ALG_NONE=
# JWT_SKIP_VERIFY=
# JWT_ALLOW_HS256=
# JWT_WEAK_HMAC_SECRET=
# JWT_TRUST_KID=
# JWT_TRUST_JKU=
# JWT_SKIP_EXPIRY=
# JWT_IN_LOCALSTORAGE=
