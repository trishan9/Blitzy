{
  "name": "blitzy-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/server.ts",
    "build": "tsup src/server.ts --format cjs --out-dir dist",
    "start": "node --frozen-intrinsics dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:from-mongo": "ts-node --transpile-only scripts/migrate-from-mongo.ts",
    "demo:list": "ts-node --transpile-only src/security/demo-list.ts",
    "verify": "ts-node --transpile-only src/__checks__/verify.ts && ts-node --transpile-only src/__checks__/ssrf.ts && ts-node --transpile-only src/__checks__/upload.ts && ts-node --transpile-only src/__checks__/step10.ts && ts-node --transpile-only src/__checks__/ai.ts && ts-node --transpile-only src/__checks__/webhook-csv.ts && ts-node --transpile-only src/__checks__/esewa.ts",
    "typecheck": "tsc --noEmit",
    "verify:db": "ts-node --transpile-only src/__checks__/db-live.ts",
    "verify:auth": "ts-node --transpile-only src/__checks__/auth-live.ts",
    "verify:live": "npm run verify:db && npm run verify:auth && npm run verify:checkout && npm run verify:http && npm run verify:e2e && npm run verify:routes && npm run verify:features && npm run verify:mongo",
    "verify:checkout": "ts-node --transpile-only src/__checks__/checkout-live.ts",
    "demo:pair": "ts-node --transpile-only src/__checks__/demo-pair.ts",
    "verify:http": "ts-node --transpile-only src/__checks__/step12.ts",
    "verify:e2e": "ts-node --transpile-only src/__checks__/http-live.ts",
    "verify:routes": "ts-node --transpile-only src/__checks__/routes-live.ts",
    "demo:pairs": "ts-node --transpile-only src/__checks__/demo/run.ts",
    "verify:mongo": "ts-node --transpile-only src/__checks__/mongo-live.ts",
    "verify:features": "ts-node --transpile-only src/__checks__/features-live.ts",
    "seed": "ts-node --transpile-only src/db/seed.ts",
    "seed:users": "ts-node --transpile-only src/db/seed-users.ts",
    "seed:all": "npm run seed && npm run seed:users",
    "dev:log": "node -e \"require('fs').mkdirSync('../logs',{recursive:true})\" && npm run dev 2>&1 | tee -a ../logs/api.log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@better-auth/passkey": "^1.6.24",
    "@node-rs/argon2": "^2.0.2",
    "@types/streamifier": "^0.1.2",
    "ai": "^6.0.207",
    "better-auth": "^1.6.24",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "ipaddr.js": "^2.4.0",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.1.0",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "streamifier": "^0.1.1",
    "stripe": "^20.4.1",
    "undici": "^8.8.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
